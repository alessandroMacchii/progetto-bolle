<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Carico merci — revisione bolle</title>
<style>
  :root{
    --bg:#f4f5f3; --card:#fff; --bordo:#d8dbd6; --testo:#1d2320; --tenue:#6b7269;
    --accento:#2f5233; --accento-chiaro:#e8f0e9;
    --avviso:#8a6100; --avviso-bg:#fdf4e0; --errore:#93331f; --errore-bg:#fbeae6;
  }
  *{box-sizing:border-box}
  [hidden]{display:none!important}   /* altrimenti display:grid di main lo sovrascrive */
  body{margin:0;font:14px/1.5 -apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--testo)}
  button{font:inherit;cursor:pointer;border:1px solid var(--bordo);background:#fff;border-radius:6px;padding:5px 11px}
  button:hover{border-color:var(--accento)}
  button.primario{background:var(--accento);color:#fff;border-color:var(--accento)}
  button.primario:hover{filter:brightness(1.15)}
  button:disabled{opacity:.45;cursor:not-allowed}
  input,select{font:inherit;border:1px solid var(--bordo);border-radius:5px;padding:4px 6px;background:#fff;width:100%}
  input:focus,select:focus{outline:2px solid var(--accento-chiaro);border-color:var(--accento)}

  header{display:flex;gap:14px;align-items:center;padding:10px 16px;background:var(--card);border-bottom:1px solid var(--bordo);flex-wrap:wrap}
  header h1{font-size:15px;margin:0;font-weight:650;letter-spacing:-.01em}
  .spazio{flex:1}
  .pillola{font-size:11px;padding:2px 8px;border-radius:99px;background:var(--accento-chiaro);color:var(--accento);font-weight:600}

  main{display:grid;grid-template-columns:minmax(320px,38%) 1fr;gap:14px;padding:14px;align-items:start}
  @media(max-width:1100px){main{grid-template-columns:1fr}}
  .card{background:var(--card);border:1px solid var(--bordo);border-radius:10px}
  .card>.testa{display:flex;gap:8px;align-items:center;padding:8px 12px;border-bottom:1px solid var(--bordo);flex-wrap:wrap}
  .card>.corpo{padding:12px}

  #viewport{overflow:auto;max-height:calc(100vh - 235px);background:#e9ebe8;border-radius:0 0 10px 10px}
  #tela{position:relative}
  #scansione{position:absolute;top:0;left:0;transform-origin:top left}

  table{width:100%;border-collapse:collapse}
  th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--tenue);
     padding:7px 6px;border-bottom:1px solid var(--bordo);position:sticky;top:0;background:var(--card);z-index:1}
  td{padding:4px 6px;border-bottom:1px solid #eef0ed;vertical-align:middle}
  tr.eliminata{opacity:.45}
  tr.eliminata input,tr.eliminata select{text-decoration:line-through}
  tr.segnalata td:first-child{box-shadow:inset 3px 0 0 var(--avviso)}
  .azioni{display:flex;gap:4px;white-space:nowrap}
  .azioni button{padding:3px 7px;font-size:12px}

  .nota{font-size:12px;padding:7px 10px;border-radius:7px;margin:6px 0}
  .nota.avviso{background:var(--avviso-bg);color:var(--avviso)}
  .nota.errore{background:var(--errore-bg);color:var(--errore)}
  .nota.ok{background:var(--accento-chiaro);color:var(--accento)}
  .tenue{color:var(--tenue)}
  .mini{font-size:12px}
  .badge{display:inline-block;min-width:17px;text-align:center;font-size:11px;font-weight:700;
         background:var(--avviso);color:#fff;border-radius:99px;padding:0 5px;cursor:help}
  #dropzone{border:2px dashed var(--bordo);border-radius:10px;padding:34px;text-align:center;color:var(--tenue);background:var(--card)}
  #dropzone.sopra{border-color:var(--accento);background:var(--accento-chiaro)}
  .pagine{display:flex;gap:4px;flex-wrap:wrap}
  .pagine button.attiva{background:var(--accento);color:#fff;border-color:var(--accento)}
  .totali{display:flex;gap:16px;font-size:12px;color:var(--tenue);padding:8px 12px;border-top:1px solid var(--bordo);flex-wrap:wrap}
  .totali b{color:var(--testo)}
</style>
</head>
<body>

<header>
  <h1>Carico merci — revisione bolle</h1>
  <span class="pillola" id="pillola-backend">…</span>
  <div class="spazio"></div>
  <select id="scelta-doc" style="width:auto;min-width:230px"></select>
  <button id="btn-nuovo">Nuova bolla</button>
</header>

<div id="schermata-upload" style="padding:40px 16px;max-width:620px;margin:0 auto">
  <div id="dropzone">
    <p style="margin:0 0 14px"><b>Trascina qui la bolla</b><br>PDF o immagine scansionata</p>
    <button class="primario" id="btn-sfoglia">Scegli file…</button>
    <input type="file" id="file" accept=".pdf,image/*" hidden>
    <p class="mini" style="margin:16px 0 0">L'estrazione richiede qualche secondo per pagina.</p>
  </div>
  <div id="stato-upload"></div>
</div>

<main id="schermata-lavoro" hidden>
  <section class="card">
    <div class="testa">
      <strong class="mini">Pagina</strong>
      <div class="pagine" id="pagine"></div>
      <div class="spazio"></div>
      <button id="btn-ruota" title="Ruota la vista di 90°">Ruota</button>
      <button id="btn-zoom-meno">−</button>
      <button id="btn-zoom-piu">+</button>
    </div>
    <div id="viewport"><div id="tela"><img id="scansione" alt="scansione della bolla"></div></div>
    <div class="totali" id="meta-pagina"></div>
  </section>

  <section class="card">
    <div class="testa">
      <button class="primario" id="btn-aggiungi">+ Riga manuale</button>
      <span class="tenue mini">Assegna a</span>
      <span id="bottoni-magazzino" style="display:flex;gap:4px"></span>
      <div class="spazio"></div>
      <label class="mini tenue" style="display:flex;gap:5px;align-items:center;white-space:nowrap">
        <input type="checkbox" id="tutte-pagine" style="width:auto"> tutte le pagine
      </label>
      <button class="primario" id="btn-export">Esporta Excel</button>
    </div>
    <div class="corpo" style="padding:0;overflow:auto;max-height:calc(100vh - 250px)">
      <table>
        <thead><tr>
          <th style="width:26px"></th><th style="width:36px">Pag</th><th style="width:34px">Seq</th>
          <th style="width:96px">Codice</th><th>Descrizione</th>
          <th style="width:66px">Taglia</th><th style="width:86px">Variante</th>
          <th style="width:62px">Qtà</th><th style="width:96px">Magazzino</th><th style="width:112px"></th>
        </tr></thead>
        <tbody id="righe"></tbody>
      </table>
    </div>
    <div class="totali" id="riepilogo"></div>
    <div class="corpo" id="esito-export" style="padding-top:0"></div>
  </section>
</main>

<script>
const $ = s => document.querySelector(s);
let DOC = null, CONFIG = null, PAGINA = 1, ZOOM = 1, ROTAZIONE = 0;

const api = async (url, opzioni) => {
  const r = await fetch(url, opzioni);
  if (!r.ok) throw new Error((await r.json().catch(() => ({}))).detail || r.statusText);
  return r.json();
};

// --- avvio ------------------------------------------------------------------
(async function avvio(){
  CONFIG = await api('/api/config');
  $('#pillola-backend').textContent = 'motore: ' + CONFIG.backend;
  $('#bottoni-magazzino').innerHTML = CONFIG.magazzini
    .map(m => `<button data-mag="${m}">${m}</button>`).join('');
  $('#bottoni-magazzino').onclick = e => {
    const m = e.target.dataset.mag;
    if (m) assegnaMassivo(m);
  };
  await ricaricaElenco();
})();

async function ricaricaElenco(selezionato){
  const elenco = await api('/api/documenti');
  $('#scelta-doc').innerHTML = '<option value="">— seleziona una bolla —</option>' +
    elenco.map(d => `<option value="${d.id}">${d.nome} · ${d.pagine} pag · ${d.righe} righe${d.esportato ? ' ✓' : ''}</option>`).join('');
  if (selezionato) { $('#scelta-doc').value = selezionato; await apri(selezionato); }
}

$('#scelta-doc').onchange = e => e.target.value ? apri(e.target.value) : mostraUpload();
$('#btn-nuovo').onclick = mostraUpload;

function mostraUpload(){
  $('#schermata-lavoro').hidden = true;
  $('#schermata-upload').hidden = false;
  $('#stato-upload').innerHTML = '';
}

// --- upload -----------------------------------------------------------------
$('#btn-sfoglia').onclick = () => $('#file').click();
$('#file').onchange = e => e.target.files[0] && invia(e.target.files[0]);
const dz = $('#dropzone');
dz.ondragover = e => { e.preventDefault(); dz.classList.add('sopra'); };
dz.ondragleave = () => dz.classList.remove('sopra');
dz.ondrop = e => { e.preventDefault(); dz.classList.remove('sopra'); e.dataTransfer.files[0] && invia(e.dataTransfer.files[0]); };

async function invia(file){
  $('#stato-upload').innerHTML = '<div class="nota ok">Estrazione in corso… (qualche secondo per pagina)</div>';
  const fd = new FormData(); fd.append('file', file);
  try {
    const doc = await api('/api/documenti', { method:'POST', body: fd });
    await ricaricaElenco(doc.id);
  } catch (err) {
    $('#stato-upload').innerHTML = `<div class="nota errore">Errore: ${err.message}</div>`;
  }
}

// --- documento --------------------------------------------------------------
async function apri(id){
  DOC = await api('/api/documenti/' + id);
  PAGINA = DOC.pagine.length ? DOC.pagine[0].numero : 1;
  ROTAZIONE = 0;
  $('#schermata-upload').hidden = true;
  $('#schermata-lavoro').hidden = false;
  disegna();
}

function paginaCorrente(){ return DOC.pagine.find(p => p.numero === PAGINA) || {}; }

function disegna(){
  $('#pagine').innerHTML = DOC.pagine.map(p => {
    const problemi = ((p.avvisi||[]).length || p.errore) ? ' ⚠' : '';
    return `<button data-p="${p.numero}" class="${p.numero===PAGINA?'attiva':''}">${p.numero}${problemi}</button>`;
  }).join('');
  $('#pagine').onclick = e => {
    const n = e.target.dataset.p;
    if (n) { PAGINA = +n; ROTAZIONE = paginaCorrente().rotazione || 0; disegna(); }
  };

  const p = paginaCorrente();
  ROTAZIONE = ROTAZIONE || (p.rotazione || 0);
  $('#scansione').src = `/api/documenti/${DOC.id}/pagine/${PAGINA}.png`;

  const meta = [];
  if (p.tipo_documento) meta.push(`<span><b>${p.tipo_documento}</b></span>`);
  if (p.numero_documento) meta.push(`<span>n. <b>${p.numero_documento}</b></span>`);
  if (p.data_documento) meta.push(`<span>del <b>${p.data_documento}</b></span>`);
  if (p.total_pieces) meta.push(`<span>Total Pieces <b>${p.total_pieces}</b></span>`);
  $('#meta-pagina').innerHTML = meta.join('') +
    (p.errore ? `<div class="nota errore" style="flex:1 0 100%">${p.errore}</div>` : '') +
    (p.avvisi||[]).map(a => `<div class="nota avviso" style="flex:1 0 100%">${a}</div>`).join('');

  disegnaRighe();
}

function applicaTrasformazione(){
  const img = $('#scansione'), tela = $('#tela');
  if (!img.naturalWidth) return;

  // dimensioni volute dell'immagine, prima di ruotarla
  const larghezza = $('#viewport').clientWidth * ZOOM;
  const altezza = larghezza * img.naturalHeight / img.naturalWidth;
  img.style.width = larghezza + 'px';
  img.style.height = 'auto';

  // ruotando attorno all'angolo in alto a sinistra l'immagine esce dal
  // riquadro: la si riporta dentro con una traslazione, diversa per ogni verso
  const rientro = {0:[0,0], 90:[altezza,0], 180:[larghezza,altezza], 270:[0,larghezza]}[ROTAZIONE] || [0,0];
  img.style.transform = `translate(${rientro[0]}px, ${rientro[1]}px) rotate(${ROTAZIONE}deg)`;

  // la trasformazione non occupa spazio: la tela le da' l'ingombro per scorrere
  const coricata = ROTAZIONE % 180 !== 0;
  tela.style.width = (coricata ? altezza : larghezza) + 'px';
  tela.style.height = (coricata ? larghezza : altezza) + 'px';
}
$('#btn-ruota').onclick = () => { ROTAZIONE = (ROTAZIONE + 90) % 360; applicaTrasformazione(); };
$('#btn-zoom-piu').onclick = () => { ZOOM = Math.min(ZOOM * 1.3, 6); applicaTrasformazione(); };
$('#btn-zoom-meno').onclick = () => { ZOOM = Math.max(ZOOM / 1.3, .4); applicaTrasformazione(); };
$('#scansione').onload = applicaTrasformazione;

// --- righe ------------------------------------------------------------------
function righeVisibili(){
  return $('#tutte-pagine').checked ? DOC.righe : DOC.righe.filter(r => r.pagina === PAGINA);
}
$('#tutte-pagine').onchange = disegnaRighe;

function disegnaRighe(){
  const righe = righeVisibili();
  $('#righe').innerHTML = righe.map(r => {
    const avvisi = r.avvisi || [];
    const badge = avvisi.length
      ? `<span class="badge" title="${avvisi.join(' &#10;').replace(/"/g,'&quot;')}">${avvisi.length}</span>` : '';
    const opzioni = CONFIG.magazzini
      .map(m => `<option ${m===r.magazzino?'selected':''}>${m}</option>`).join('');
    return `<tr data-id="${r.id}" class="${r.eliminata?'eliminata':''} ${avvisi.length?'segnalata':''}">
      <td>${badge}</td>
      <td class="tenue mini">${r.pagina}</td>
      <td class="tenue mini">${r.seq||''}</td>
      <td><input data-c="codice_articolo" value="${r.codice_articolo||''}"></td>
      <td class="mini tenue">${[r.descrizione, r.colore].filter(Boolean).join(' · ')}</td>
      <td class="mini">${r.taglia||''}</td>
      <td><input data-c="variante" value="${r.variante||''}"></td>
      <td><input data-c="qta" type="number" min="0" value="${r.qta}"></td>
      <td><select data-c="magazzino">${opzioni}</select></td>
      <td class="azioni">
        <button data-a="dividi" ${r.qta<2||r.eliminata?'disabled':''} title="Dividi fra due magazzini">Dividi</button>
        <button data-a="elimina">${r.eliminata?'Ripristina':'Elimina'}</button>
      </td>
    </tr>`;
  }).join('') || '<tr><td colspan="10" class="tenue" style="padding:18px">Nessuna riga su questa pagina.</td></tr>';

  const attive = DOC.righe.filter(r => !r.eliminata);
  const perMag = {};
  attive.forEach(r => perMag[r.magazzino] = (perMag[r.magazzino]||0) + r.qta);
  $('#riepilogo').innerHTML =
    `<span>Righe attive <b>${attive.length}</b></span>` +
    `<span>Pezzi totali <b>${attive.reduce((s,r)=>s+r.qta,0)}</b></span>` +
    Object.entries(perMag).map(([m,q]) => `<span>${m} <b>${q}</b></span>`).join('') +
    `<span class="spazio"></span><span>Righe con segnalazioni <b>${DOC.righe.filter(r=>(r.avvisi||[]).length).length}</b></span>`;
}

$('#righe').addEventListener('change', async e => {
  const tr = e.target.closest('tr'); if (!tr) return;
  const campo = e.target.dataset.c; if (!campo) return;
  const valore = campo === 'qta' ? +e.target.value : e.target.value;
  const aggiornata = await api(`/api/documenti/${DOC.id}/righe/${tr.dataset.id}`, {
    method:'PATCH', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({[campo]: valore})
  });
  Object.assign(DOC.righe.find(r => r.id === tr.dataset.id), aggiornata);
  disegnaRighe();
});

$('#righe').addEventListener('click', async e => {
  const azione = e.target.dataset.a; if (!azione) return;
  const id = e.target.closest('tr').dataset.id;
  const riga = DOC.righe.find(r => r.id === id);

  if (azione === 'elimina') {
    const agg = await api(`/api/documenti/${DOC.id}/righe/${id}`, {
      method:'PATCH', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ eliminata: !riga.eliminata })
    });
    Object.assign(riga, agg);
    disegnaRighe();
  }

  if (azione === 'dividi') {
    const quanti = prompt(`Quanti dei ${riga.qta} pezzi vanno su un altro magazzino?`, '1');
    if (!quanti) return;
    const altro = CONFIG.magazzini.find(m => m !== riga.magazzino) || CONFIG.magazzini[0];
    const dove = prompt(`Su quale magazzino? (${CONFIG.magazzini.join(' / ')})`, altro);
    if (!dove) return;
    try {
      await api(`/api/documenti/${DOC.id}/righe/${id}/dividi`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ qta:+quanti, magazzino: dove.trim() })
      });
      DOC = await api('/api/documenti/' + DOC.id);
      disegnaRighe();
    } catch (err) { alert(err.message); }
  }
});

$('#btn-aggiungi').onclick = async () => {
  await api(`/api/documenti/${DOC.id}/righe?pagina=${PAGINA}`, { method:'POST' });
  DOC = await api('/api/documenti/' + DOC.id);
  disegnaRighe();
};

async function assegnaMassivo(magazzino){
  const corpo = { magazzino };
  if (!$('#tutte-pagine').checked) corpo.pagina = PAGINA;
  await api(`/api/documenti/${DOC.id}/magazzino`, {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(corpo)
  });
  DOC = await api('/api/documenti/' + DOC.id);
  disegnaRighe();
}

// --- export -----------------------------------------------------------------
$('#btn-export').onclick = async () => {
  const esito = $('#esito-export');
  const v = await api(`/api/documenti/${DOC.id}/verifica`);
  if (v.problemi.length) {
    esito.innerHTML = v.problemi.map(p => `<div class="nota errore">${p}</div>`).join('');
    return;
  }
  esito.innerHTML = `<div class="nota ok">${v.anteprima.length} righe pronte per l'import. Scaricamento…</div>`;
  window.location = `/api/documenti/${DOC.id}/export`;
};
</script>
</body>
</html>
