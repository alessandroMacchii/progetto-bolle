# Copia questo file in .env e inserisci la chiave API
ANTHROPIC_API_KEY=sk-ant-...

# Modello usato per l'estrazione (default: claude-opus-5)
BOLLE_MODEL=claude-opus-5

# Motore di estrazione: claude | openrouter | mock (mock = nessuna chiamata, rilegge il gold set)
BOLLE_EXTRACTOR=claude

# --- prova con Gemini (o altri modelli) via OpenRouter ---------------------
# Chiave da https://openrouter.ai/keys. Serve anche al banco di prova (bench/esegui.py).
OPENROUTER_API_KEY=
# Per usarlo nell'app metti BOLLE_EXTRACTOR=openrouter
BOLLE_OPENROUTER_MODEL=google/gemini-3.5-flash
