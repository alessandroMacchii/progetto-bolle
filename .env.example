# Copia questo file in .env e inserisci la chiave API
ANTHROPIC_API_KEY=sk-ant-...

# Modello usato con BOLLE_EXTRACTOR=claude (default: claude-opus-5-5)
BOLLE_MODEL=claude-opus-5-5

# Motore di estrazione: consenso | claude | openrouter | mock (mock = nessuna chiamata, rilegge il gold set)
# consenso = Gemini Flash + Haiku, Opus se non concordano (serve OPENROUTER_API_KEY)
BOLLE_EXTRACTOR=consenso

# --- prova con Gemini (o altri modelli) via OpenRouter ---------------------
# Chiave da https://openrouter.ai/keys. Serve anche al banco di prova (bench/esegui.py).
OPENROUTER_API_KEY=
# Per usarlo nell'app metti BOLLE_EXTRACTOR=openrouter
BOLLE_OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Login del browser. Vuota = nessun login (solo sul PC). Online e' obbligatoria;
# "Avvia prova online.bat" la genera da solo se manca.
BOLLE_PASSWORD=
